# OCTV production build context: never send private files or large local assets to Docker
.git
.github
.env
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.jks
*service-account*.json
*service_account*.json
*firebase-adminsdk*.json
firebase-credentials*.json
secrets/
frontend/mobile/google-services.json
frontend/mobile/android/
frontend/mobile/ios/
node_modules/
**/node_modules/
.venv/
venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.expo/
.vite/
dist/
**/dist/
logs/
*.log
*.mp4
*.pt
*.pth
*.onnx
*.apk
*.aab
*.dump
*.backup
database/backups/
.pgdata/
postgres-data/
demo/videos/
datasets/
runs/
checkpoints/
local_data/
.sites-runtime/

# Extra failsafe for frequently named production credentials
**/production.env
**/firebase-admin.json
**/*firebase*service*.json
**/secrets*.env

# Avoid accidental local archives, backup databases and generic credentials in images.
*.zip
*.tar
*.tar.gz
*.tgz
*.sqlite
*.sqlite3
*.db
**/credentials.json
*.keystore
