# 백엔드 접속 / 앱에 공개되는 설정
# 모바일이 접속할 백엔드 주소; 실기기는 PC의 IPv4와 포트 8000
EXPO_PUBLIC_API_BASE_URL=

# Android / Firebase / 빌드
# Firebase에 등록한 Android 패키지명
OCTV_ANDROID_PACKAGE=com.octv.mobile
# Android용 google-services.json 위치
OCTV_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
# EAS 빌드를 사용하는 경우 Expo 프로젝트 ID 입력
OCTV_EAS_PROJECT_ID=
# Android HTTP 접속 허용; 기본 0, 로컬 HTTP 시험 시 직접 1로 변경
OCTV_ANDROID_ALLOW_HTTP=0
