# 전체 흐름: 알림 API 주소 설정 → Android Firebase 앱 설정 → APK 빌드.
# 휴대폰 앱이 어느 서버에 접속하고, 어떤 Firebase 앱으로 동작할지 정하는 설정
EXPO_PUBLIC_API_BASE_URL= # 모바일 앱이 접속할 백엔드 주소
OCTV_ANDROID_PACKAGE=com.octv.mobile # Android 에서 앱을 구분하는 고유 이름 / 같은 OCTV 앱이라면 동일하게 사용하여야 함
OCTV_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json # Firebase Android 설정 파일의 위치
OCTV_EAS_PROJECT_ID= # Expo의 EAS 프로젝트 식별자
OCTV_ANDROID_ALLOW_HTTP=0 # Android 앱에서 HTTP 접속을 허용할지 결정 / 로컬 HTTP 테스트는 1, HTTPS 사용은 0
