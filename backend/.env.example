# Optional DB override. Leave blank to use the root .env POSTGRES_* values.
# If set, use the same DB/user/password/host port as Docker Compose.
# URL-encode special characters in a URL password. Never commit a real URL.
DATABASE_URL=
JWT_SECRET=
WEATHER_API_KEY=
WATER_LEVEL_API_KEY=
TRAFFIC_API_KEY=
ROUTE_API_KEY=
LLM_API_KEY=

# 기준정보 동기화 API

# 공공데이터포털 - 행정안전부 행정표준코드 법정동코드
