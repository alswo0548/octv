# DB / 로그인 / 브라우저 접속
# 선택; 비우면 루트 .env의 POSTGRES_*로 DB 접속
DATABASE_URL=
# 로그인 토큰 서명 비밀값
JWT_SECRET=
# 직접 API를 부르는 웹 주소
OCTV_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# LangGraph / 기상·수위·교통·경로
# 사건 지역 강수량·풍속 조회
WEATHER_API_KEY=
# 하천 수위 조회
WATER_LEVEL_API_KEY=
# 돌발·통제 정보 조회
TRAFFIC_API_KEY=
# 카카오 자동차 길찾기로 출동 경로 후보 조회
ROUTE_API_KEY=
# 카카오 주변 병원·학교 조회; 비우면 ROUTE_API_KEY 사용
PLACES_API_KEY=
# LangGraph가 읽을 JSON 경로; 프로젝트 루트 기준
OCTV_RUNTIME_CONFIG=ai/.env.runtime.json

# 기관·지역 기준정보 적재
# 법정동 코드·지역명 수집
DATA_GO_KR_SERVICE_KEY=
# 기상특보 구역 코드 수집과 현재 기상특보 조회
KMA_API_KEY=
# 공통POI_경찰에서 경찰기관 정보 수집
SAFETY_DATA_SERVICE_KEY=
# 경기도 관공서 정보에서 시청·군청 등 수집
GYEONGGI_DATA_KEY=
# 공통POI에서 서울 구청 정보 수집
SAFETY_DATA_COMMON_POI_KEY=
# 서울 조직도·직원업무 정보에서 도로관리기관 수집
SEOUL_OPENAPI_KEY=
# 기관 주소를 위도·경도로 변환
KAKAO_REST_API_KEY=

# CCTV / 지역 경계
# UTIC CCTV 영상 주소 조회
UTIC_CCTV_KEY=
# 시군구 경계를 조회해 CCTV 소속 지역 판별
VWORLD_API_KEY=
# 선택; VWorld에 등록한 도메인이 필요한 경우 입력
VWORLD_DOMAIN=

# Redis / Android 푸시
# 토큰·푸시 처리용 Redis 주소; 루트 .env와 동일하게 유지
OCTV_REDIS_URL=redis://127.0.0.1:6379/0
# 휴대폰 푸시 발송; 0: 끔, 1: 켬
OCTV_PUSH_ENABLED=0
# 푸시 발송용 Firebase 프로젝트 ID
OCTV_FIREBASE_PROJECT_ID=
# 서버용 Firebase 서비스 계정 JSON 경로
GOOGLE_APPLICATION_CREDENTIALS=
# 푸시 대상 시작 시각
OCTV_PUSH_START_AT=
# 누락 푸시 재등록; 0: 끔, 1: 켬
OCTV_PUSH_RECOVERY_ENABLED=0

# 영상 중계 / 탐지 모델
# 선택; 재난 모델 .pt 경로, 비우면 루트 yolo11s.pt 사용
OCTV_YOLO_MODEL_PATH=

# 자동 매핑
OCTV_AUTO_MAPPING_ENABLED=1