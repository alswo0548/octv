# LangGraph Context / 기관·경로 분석
WEATHER_API_KEY=
WATER_LEVEL_API_KEY=
TRAFFIC_API_KEY=
ROUTE_API_KEY=
PLACES_API_KEY=

# 기관·지역 기준정보 적재용
DATA_GO_KR_SERVICE_KEY=
KMA_API_KEY=
SAFETY_DATA_SERVICE_KEY=
GYEONGGI_DATA_KEY=
SAFETY_DATA_COMMON_POI_KEY=
SEOUL_OPENAPI_KEY=

# Kakao Developers - Kakao Map REST API
KAKAO_REST_API_KEY=

# CCTV 영상
UTIC_CCTV_KEY=

# 시, 도 지도 경계 조회
VWORLD_API_KEY=
VWORLD_DOMAIN=

# 기존 Redis (API, Worker, Beat의 프로세스 환경변수로 주입)
# 실행 환경변수는 Windows cmd의 set으로 지정하며, Firebase 인증 파일은 프로젝트 밖에 보관합니다.
OCTV_REDIS_URL=redis://127.0.0.1:6379/0
OCTV_PUSH_ENABLED=0
OCTV_FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Push 첫 활성화 직전의 고정 ISO 8601 시각. timezone 필수 (+09:00 또는 Z).
# API/Worker/Beat에 같은 값을 사용하고 재시작 때마다 바꾸지 않습니다.
OCTV_PUSH_START_AT=
# 자동 누락 복구를 사용할 때만 1. 기본 OFF, Beat는 한 개만 실행합니다.
OCTV_PUSH_RECOVERY_ENABLED=0
