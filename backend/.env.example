# 기상청 API허브 - 기상특보 지역코드
KMA_API_KEY=

# 재난안전데이터 공유플랫폼 - 공통POI 경찰
SAFETY_DATA_SERVICE_KEY=

# 경기데이터드림 - GovernmentOffice
GYEONGGI_DATA_KEY=

# 재난안전데이터 공유플랫폼 - 공통POI
