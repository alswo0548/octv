# LangGraph Context / 기관·경로 분석
WEATHER_API_KEY= # 사건 지역의 강수량,풍속 등 기상정보 조회
WATER_LEVEL_API_KEY= # 하천 수위 조회
TRAFFIC_API_KEY= # 도로 돌발상황,통제 등 교통정보 조회
ROUTE_API_KEY= # 카카오 경로 API로 출동 경로 후보 조회
PLACES_API_KEY= # 카카오 장소 API로 사건 주변 병원,학교 조회

# 기관·지역 기준정보 적재용
DATA_GO_KR_SERVICE_KEY= # 지역 코드,지역명 수집
KMA_API_KEY= # 기상특보 구역 코드 수집 + 현재 기상특보 조회
SAFETY_DATA_SERVICE_KEY= # 경찰기관 정보 수집
GYEONGGI_DATA_KEY= # 경기도 시청,군청 등 지자체 기관 정보 수집
SAFETY_DATA_COMMON_POI_KEY= # 공공시설 위치정보에서 서울 구청 정보 수집
SEOUL_OPENAPI_KEY= # 서울 도로관리기관 정보 수집
KAKAO_REST_API_KEY= # 기관 주소를 지도 좌표인 위도,경도로 변환

# CCTV 및 지역 경계 설정
UTIC_CCTV_KEY= # UTIC에서 CCTV 영상 스트림 주소 조회
VWORLD_API_KEY= # 시군구 경계를 가져와 CCTV가 어느 지역에 속하는지 판별
VWORLD_DOMAIN= # VWorld 요청에 사용하는 등록 도메인. 필요한 경우 설정

# 알림 기능 관련 설정
OCTV_REDIS_URL=redis://127.0.0.1:6379/0 # 작업 대기열, 기기 토큰,발송 처리 기록을 관리하는 Redis 주소
OCTV_PUSH_ENABLED=0 # 휴대폰 푸시 발송 스위치 / 0: 끔 / 1: 켬
OCTV_FIREBASE_PROJECT_ID= # 푸시 발송에 사용할 Firebase 프로젝트 ID
GOOGLE_APPLICATION_CREDENTIALS= # 서버가 Firebase에 인증할 때 사용할 파일의 경로
OCTV_PUSH_START_AT= # 푸시 대상으로 삼을 알림의 생성 시각 기준
OCTV_PUSH_RECOVERY_ENABLED=0 # 누락된 푸시 작업을 주기적으로 찾아 다시 등록할지 결정 / 0: 끔 / 1: 켬

# Firebase란? 
# Google이 제공하는 앱 개발 지원 서비스. 
# 로그인, 데이터 저장, 알림 발송 등 여러 기능을 제공
# 브라우저에서 여는 웹페이지 주소를 쉼표로 구분합니다. 휴대폰 접속은 현재 PC IP:웹 포트를 추가하세요.
# 새 설정이며 끝 슬래시·/api 경로·*를 넣지 않습니다. 배포 시 실제 HTTPS 웹 주소로 바꾸세요.
OCTV_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
