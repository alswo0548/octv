{
  "name": "octv",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend/web",
    "frontend/mobile",
    "shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@octv/web",
    "dev:mobile": "npm run start --workspace=@octv/mobile",
    "dev:mobile:web": "npm run web --workspace=@octv/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build --workspace=@octv/web",
    "build:mobile:web": "npm run export:web --workspace=@octv/mobile",
    "build:mobile:native": "npm run export:native --workspace=@octv/mobile",
    "check:scope": "node scripts/check-scope.mjs",
    "dev": "vite frontend/web",
    "preview:mobile:web": "vite preview frontend/mobile --outDir dist --host localhost --port 8081",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,js,jsx,css,html,json}\" \"shared/src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,js,jsx,css,html,json}\" \"shared/src/**/*.{ts,json}\"",
    "preview:web": "vite preview frontend/web --host localhost --port 4173"
  },
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
