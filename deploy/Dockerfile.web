# Build the current React/Vite workspace; serve static files from nginx.
FROM node:24-alpine AS builder
WORKDIR /src
COPY package.json package-lock.json ./
COPY frontend/web/package.json frontend/web/package.json
COPY frontend/mobile/package.json frontend/mobile/package.json
COPY shared/package.json shared/package.json
RUN npm ci
# Existing web route type definitions import mobile/src/liveRoutes.ts.
# Copy the mobile source tree for TypeScript module resolution; do not modify it.
COPY frontend/web frontend/web
COPY frontend/mobile/src frontend/mobile/src
COPY shared shared
RUN npm run build:web

FROM nginx:1.29-alpine
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/frontend/web/dist /usr/share/nginx/html
