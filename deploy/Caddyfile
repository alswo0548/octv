# Configure an A record for OCTV_PUBLIC_HOST before enabling HTTPS.
{$OCTV_PUBLIC_HOST} {
    encode zstd gzip
    # Demo playback tickets are URL bearer tokens; do not send them as Referer.
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:80
    }
}

# Public WebRTC reverse proxy deliberately DISABLED by default.
# Enabling the stream hostname requires real access control and test on Android/web.
