# Copy to /etc/octv/production.env on Linux, protect permissions (0600).
# Never commit the populated version. Replace ALL <...> placeholders.
OCTV_SECRETS_FILE=/etc/octv/production.env
OCTV_RELEASE_TAG=20261027-preflight
OCTV_PUBLIC_HOST=octv.example.com
OCTV_STREAM_HOST=stream.octv.example.com
OCTV_WEBRTC_PUBLIC_IP=<DROPLET_PUBLIC_IPV4>

POSTGRES_DB=octv_dev
POSTGRES_USER=octv_dev
POSTGRES_PASSWORD=<STRONG_DB_PASSWORD>
# Properly URL-encode the password; Docker network DB hostname is 'db'.
DATABASE_URL=postgresql://octv_dev:<URL_ENCODED_DB_PASSWORD>@db:5432/octv_dev
JWT_SECRET=<EXISTING_JWT_SECRET_FOR_EXISTING_USERS>
OCTV_REDIS_URL=redis://redis:6379/0
OCTV_CORS_ALLOWED_ORIGINS=https://octv.example.com

OCTV_DEMO_ENABLED=1
OCTV_DECISION_ENABLED=1
OCTV_AUTO_MAPPING_ENABLED=1
# Preserve explicitly approved demo scenario priority calculation. Verify against local effective .env.
OCTV_DEMO_SCENARIO_RISK_ENABLED=1
OCTV_DEMO_VIDEO_DIR=/app/demo/videos
OCTV_DEMO_SCENARIO_PATH=demo/scenarios.json
# Effective local ai/.env.runtime.json must be copied securely to this host path.
# Not included in the build image; used by api, analysis, and CCTV runtime.
OCTV_RUNTIME_CONFIG_FILE=/etc/octv/runtime-config.json
OCTV_RUNTIME_CONFIG=/run/octv/runtime-config.json
# Mirrors the CURRENT local demo configuration (Cycle7.pt), not a validated general UTIC model.
# Do not treat this as an approved production/general-purpose detection model.
OCTV_YOLO_MODEL_PATH=/app/demo/videos/_v5/weights/Cycle7.pt
OCTV_YOLO_DEVICE=cpu
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_WEBRTC_BASE_URL=https://stream.octv.example.com

# Important: leave notifications OFF until recipients have been verified.
OCTV_PUSH_ENABLED=0
OCTV_PUSH_RECOVERY_ENABLED=0
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
OCTV_FIREBASE_PROJECT_ID=<EXISTING_FIREBASE_PROJECT_ID>
OCTV_PUSH_START_AT=

# Copy approved values from the existing backend/.env securely, without committing.
WEATHER_API_KEY=
WATER_LEVEL_API_KEY=
TRAFFIC_API_KEY=
ROUTE_API_KEY=
PLACES_API_KEY=
KMA_API_KEY=
UTIC_CCTV_KEY=
VWORLD_API_KEY=
VWORLD_DOMAIN=
KAKAO_REST_API_KEY=
