# Docker / PostgreSQL
# DB 이름; 기존 Docker DB와 같은 값을 사용
POSTGRES_DB=octv_dev
# DB 접속 계정; 기존 Docker DB와 같은 값을 사용
POSTGRES_USER=octv_dev
# DB 접속 비밀번호; 필수, 기존 값 유지
POSTGRES_PASSWORD=
# 내 PC에서 DB에 접속하는 포트; 기본 5432
POSTGRES_PORT=5432

# Redis / 사건 자동 분석
# Worker 대기열 주소; backend/.env와 동일하게 유지
OCTV_REDIS_URL=redis://127.0.0.1:6379/0
# 사건 자동 분석; 0: 끔, 1: 켬; 기본 0
OCTV_DECISION_ENABLED=0

# 고급 선택 / 기본값 유지 시 주석 그대로
# 중복 분석 잠금 유지 시간; 기본 21600초(6시간)
# OCTV_ANALYSIS_LOCK_TTL_SEC=21600
